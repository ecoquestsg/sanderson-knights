
---
import { site } from '../config';

const base = Astro.site
  ? Astro.site.href.replace(/\/$/, '')
  : 'https://sandersonknights.com';

const graph = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${base}/#website`,
  url: `${base}/`,
  name: site.name,
  description: site.description,
  inLanguage: 'en',
};
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(graph)}
/>
