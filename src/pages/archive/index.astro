
---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Archive">
  <section class="sk-archive-placeholder">
    <h1>ARCHIVE</h1>
    <p>The collection is being assembled.</p>
  </section>
</Layout>

<style>
  .sk-archive-placeholder {
    max-width: 680px;
    margin: 80px auto;
    text-align: center;
  }

  h1 {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.15em;
  }

  p {
    margin-top: 20px;
    color: #777777;
    font-size: 14px;
  }
</style>
