
---
import Layout from '../../layouts/Layout.astro';
import GalleryFeed from '../../components/GalleryFeed.astro';
import { makers, publishedExhibitions } from '../../data/cms';

export function getStaticPaths() {
  const activeMakerSlugs = new Set(
    publishedExhibitions.map((post) => post.makerSlug)
  );

  return makers
    .filter((maker) => activeMakerSlugs.has(maker.slug))
    .map((maker) => ({
      params: {
        maker: maker.slug,
      },
      props: {
        maker,
        posts: publishedExhibitions.filter(
          (post) => post.makerSlug === maker.slug
        ),
      },
    }));
}

const { maker, posts } = Astro.props;
---

<Layout title={maker.name}>
  <section class="sk-maker-gallery">
    <h1>{maker.name}</h1>
    <GalleryFeed posts={posts} />
  </section>
</Layout>

<style>
  .sk-maker-gallery {
    width: 100%;
  }

  h1 {
    max-width: 600px;
    margin: 28px auto 35px;
    color: #111;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.09em;
  }
</style>
