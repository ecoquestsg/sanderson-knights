
---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="ABOUT"
  description="About Sanderson Knights, an independent visual curation of horology."
>
  <section class="sk-about">
    <h1>SANDERSON KNIGHTS</h1>

    <div class="sk-about__description">
      <p>
        An independent visual curation of horology.
      </p>

      <p>
        A collection of timepieces.
      </p>
    </div>

    <span class="sk-about__est">
      EST. 2026
    </span>
  </section>
</Layout>

<style>
  .sk-about {
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    padding: 90px 0 120px;
  }

  .sk-about h1 {
    margin: 0 0 42px;
    color: #111111;
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(22px, 5vw, 32px);
    font-weight: 400;
    letter-spacing: 0.025em;
    line-height: 1.3;
  }

  .sk-about__description {
    max-width: 420px;
  }

  .sk-about__description p {
    margin: 0 0 22px;
    color: #444444;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.8;
  }

  .sk-about__est {
    display: block;
    margin-top: 90px;
    color: #999999;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.12em;
  }

  @media (min-width: 768px) {
    .sk-about {
      padding-top: 130px;
    }
  }
</style>
